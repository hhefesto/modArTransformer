cabal-version:      3.0
name:               ctc-grad-smoke
version:            0.1.0.0
synopsis:           Isolated ConCat gradient smoke test
license:            MIT
build-type:         Simple

executable ctc-grad-smoke
  main-is:          Main.hs
  build-depends:    base >=4.17 && <5
                  , concat-classes
                  , concat-examples
                  , concat-plugin
                  , ghc-prim
  ghc-options:      -O2 -threaded -rtsopts
                    -fplugin=ConCat.Plugin
                    -fsimpl-tick-factor=10000
                    -funfolding-case-threshold=1
                    -funfolding-case-scaling=5
                    -freduction-depth=0
  default-language: Haskell2010
  default-extensions:
    ConstraintKinds
    DataKinds
    FlexibleContexts
    ScopedTypeVariables
    TypeApplications
    TypeFamilies
    TypeOperators
