cabal-version:      3.0
name:               ctc-train
version:            0.1.0.0
synopsis:           CTC-compiled gradient training smoke (Milestone A)
license:            MIT
build-type:         Simple

executable ctc-train
  main-is:          Main.hs
  build-depends:    base >=4.17 && <5
                  , concat-classes
                  , concat-examples
                  , concat-plugin
                  , ghc-prim
  ghc-options:      -O2 -threaded -rtsopts
                    -fplugin=ConCat.Plugin
                    -fexpose-all-unfoldings
                    -fsimpl-tick-factor=2000
                    -freduction-depth=0
  default-language: Haskell2010
  default-extensions:
    ConstraintKinds
    DataKinds
    FlexibleContexts
    ScopedTypeVariables
    TypeApplications
    TypeFamilies
    TypeOperators

executable ctc-partrain
  main-is:          ParTrain.hs
  build-depends:    base >=4.17 && <5
                  , concat-classes
                  , concat-examples
                  , concat-plugin
                  , ghc-prim
                  , time
  ghc-options:      -O2 -threaded -rtsopts "-with-rtsopts=-N"
                    -fplugin=ConCat.Plugin
                    -fexpose-all-unfoldings
                    -fsimpl-tick-factor=2000
                    -freduction-depth=0
  default-language: Haskell2010
  default-extensions:
    ConstraintKinds
    DataKinds
    FlexibleContexts
    ScopedTypeVariables
    TypeApplications
    TypeFamilies
    TypeOperators
