cabal-version:      3.0
name:               ctc-train
version:            0.1.0.0
synopsis:           CTC-compiled gradient training smoke (Milestone A)
license:            MIT
build-type:         Simple

executable ctc-train
  main-is:          Main.hs
  build-depends:    base >=4.17 && <5
                  , concat-classes
                  , concat-examples
                  , concat-plugin
                  , ghc-prim
  -- -dshow-passes: print each Core-to-Core pass with term size + timing, so the
  -- single-module ConCat compile shows live progress (and reveals Core blow-up)
  -- instead of a long silent "[1 of 1] Compiling Main".
  ghc-options:      -O2 -threaded -rtsopts
                    -fplugin=ConCat.Plugin
                    -fexpose-all-unfoldings
                    -fsimpl-tick-factor=2000
                    -freduction-depth=0
                    -dshow-passes
  default-language: Haskell2010
  default-extensions:
    ConstraintKinds
    DataKinds
    FlexibleContexts
    ScopedTypeVariables
    TypeApplications
    TypeFamilies
    TypeOperators

executable ctc-partrain
  main-is:          ParTrain.hs
  build-depends:    base >=4.17 && <5
                  , concat-classes
                  , concat-examples
                  , concat-plugin
                  , ghc-prim
                  , time
  ghc-options:      -O2 -threaded -rtsopts "-with-rtsopts=-N"
                    -fplugin=ConCat.Plugin
                    -fexpose-all-unfoldings
                    -fsimpl-tick-factor=2000
                    -freduction-depth=0
                    -dshow-passes
  default-language: Haskell2010
  default-extensions:
    ConstraintKinds
    DataKinds
    FlexibleContexts
    ScopedTypeVariables
    TypeApplications
    TypeFamilies
    TypeOperators

executable ctc-attntrain
  main-is:          AttnTrain.hs
  build-depends:    base >=4.17 && <5
                  , concat-classes
                  , concat-examples
                  , concat-plugin
                  , ghc-prim
                  , time
  ghc-options:      -O2 -threaded -rtsopts "-with-rtsopts=-N"
                    -fplugin=ConCat.Plugin
                    -fexpose-all-unfoldings
                    -fsimpl-tick-factor=2000
                    -freduction-depth=0
                    -dshow-passes
  default-language: Haskell2010
  default-extensions:
    BangPatterns
    ConstraintKinds
    DataKinds
    FlexibleContexts
    FlexibleInstances
    ScopedTypeVariables
    TypeApplications
    TypeFamilies
    TypeOperators

-- NOTE: the full self-attention BLOCK trainer (Wq/Wk/Wv projections) lives in its
-- own isolated package `ctc-xftrain` (../ctc-xftrain), kept out of this package and
-- out of flake checks because its gradient compile is the documented heavy case
-- (~1h27m+ at this concat/ghc948 pin). Build/run it by hand:
--   nix build .#ctc-xftrain -L && ./result/bin/ctc-xftrain
