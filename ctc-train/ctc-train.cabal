cabal-version:      3.0
name:               ctc-train
version:            0.1.0.0
synopsis:           CTC-compiled gradient training smoke (Milestone A)
license:            MIT
build-type:         Simple

executable ctc-train
  main-is:          Main.hs
  build-depends:    base >=4.17 && <5
                  , concat-classes
                  , concat-examples
                  , concat-plugin
                  , ghc-prim
  -- -dshow-passes: print each Core-to-Core pass with term size + timing, so the
  -- single-module ConCat compile shows live progress (and reveals Core blow-up)
  -- instead of a long silent "[1 of 1] Compiling Main".
  ghc-options:      -O2 -threaded -rtsopts
                    -fplugin=ConCat.Plugin
                    -fexpose-all-unfoldings
                    -fsimpl-tick-factor=2000
                    -freduction-depth=0
                    -dshow-passes
  default-language: Haskell2010
  default-extensions:
    ConstraintKinds
    DataKinds
    FlexibleContexts
    ScopedTypeVariables
    TypeApplications
    TypeFamilies
    TypeOperators

executable ctc-partrain
  main-is:          ParTrain.hs
  build-depends:    base >=4.17 && <5
                  , concat-classes
                  , concat-examples
                  , concat-plugin
                  , ghc-prim
                  , time
  ghc-options:      -O2 -threaded -rtsopts "-with-rtsopts=-N"
                    -fplugin=ConCat.Plugin
                    -fexpose-all-unfoldings
                    -fsimpl-tick-factor=2000
                    -freduction-depth=0
                    -dshow-passes
  default-language: Haskell2010
  default-extensions:
    ConstraintKinds
    DataKinds
    FlexibleContexts
    ScopedTypeVariables
    TypeApplications
    TypeFamilies
    TypeOperators

executable ctc-attntrain
  main-is:          AttnTrain.hs
  build-depends:    base >=4.17 && <5
                  , concat-classes
                  , concat-examples
                  , concat-plugin
                  , ghc-prim
                  , time
  ghc-options:      -O2 -threaded -rtsopts "-with-rtsopts=-N"
                    -fplugin=ConCat.Plugin
                    -fexpose-all-unfoldings
                    -fsimpl-tick-factor=2000
                    -freduction-depth=0
                    -dshow-passes
  default-language: Haskell2010
  default-extensions:
    BangPatterns
    ConstraintKinds
    DataKinds
    FlexibleContexts
    FlexibleInstances
    ScopedTypeVariables
    TypeApplications
    TypeFamilies
    TypeOperators

-- NOTE: the self-attention block trainer XfTrain.hs is intentionally NOT built.
-- Its gradient (gradR over softmax self-attention) does not compile in practical
-- time/memory at this concat/ghc948 pin: a d=2, 20-param instance ran 1h27m with
-- RSS climbing past 6 GB (the full block with LayerNorms hit 16 GB / 67 min). The
-- forward attention elaborates fine (ctc-smoke Stage 8) and reverse-mode MLPs
-- compile fine (ctc-partrain); reverse-mode *attention* is the wall. To retry,
-- re-add an `executable ctc-xftrain` (main-is XfTrain.hs) with the flags above
-- plus -dshow-passes (and optionally -fplugin-opt=ConCat.Plugin:trace) to watch
-- whether the Core converges or grows unboundedly.
