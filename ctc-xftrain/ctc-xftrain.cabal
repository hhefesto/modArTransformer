cabal-version:      3.0
name:               ctc-xftrain
version:            0.1.0.0
synopsis:           Full self-attention block trained via CTC (heavy; isolated)
license:            MIT
build-type:         Simple

-- Isolated on purpose: its gradient compile is the documented heavy case
-- (~1h27m+ at this concat/ghc948 pin), so it is NOT a flake check and is kept
-- out of the working ctc-train package.  Build/run with no time cap:
--   nix build .#ctc-xftrain -L && ./result/bin/ctc-xftrain
--   nix develop .#ctc-xftrain --command cabal run ctc-xftrain
executable ctc-xftrain
  main-is:          Main.hs
  build-depends:    base >=4.17 && <5
                  , concat-classes
                  , concat-examples
                  , concat-plugin
                  , ghc-prim
                  , time
  ghc-options:      -O2 -threaded -rtsopts "-with-rtsopts=-N"
                    -fplugin=ConCat.Plugin
                    -fexpose-all-unfoldings
                    -fsimpl-tick-factor=2000
                    -freduction-depth=0
                    -dshow-passes
  default-language: Haskell2010
  default-extensions:
    BangPatterns
    ConstraintKinds
    DataKinds
    FlexibleContexts
    FlexibleInstances
    ScopedTypeVariables
    TypeApplications
    TypeFamilies
    TypeOperators
