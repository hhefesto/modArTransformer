cabal-version:      2.4
name:               frontend
version:            0.1.0.0
synopsis:           Reflex-dom diagram for the denotational modular-arithmetic transformer
license:            MIT
build-type:         Simple

executable frontend
  main-is:          Main.hs
  hs-source-dirs:   src
  build-depends:    base >=4 && <5
                  , reflex
                  , reflex-dom
                  , text
                  , containers
  if !impl(ghcjs)
    build-depends:  jsaddle, jsaddle-warp
  ghc-options:      -Wall -O2
  default-language: Haskell2010
  default-extensions:
    OverloadedStrings
    RecursiveDo
    ScopedTypeVariables
