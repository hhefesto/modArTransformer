cabal-version:      3.0
name:               modartransformer-backend
version:            0.1.0.0
synopsis:           Backend experiments for the modular arithmetic transformer
license:            MIT
build-type:         Simple

-- Finite-difference gradient check: guarantees the Wengert-tape reverse-mode
-- adjoints match numerical differences (CI gate, run by checks.transformer-gradcheck).
executable transformer-gradcheck
  main-is:          GradCheck.hs
  hs-source-dirs:   backend/transformer
  other-modules:    AD, Tensor, Tape, Serialize, Transformer
  build-depends:    base >=4.17 && <5
                  , hmatrix
                  , random
                  , vector
                  , deepseq
  ghc-options:      -O2 -threaded -rtsopts
  default-language: Haskell2010

-- Haskell side of the Agda<->backend conformance oracle.
executable transformer-conformance
  main-is:          Conformance.hs
  hs-source-dirs:   backend/transformer
  other-modules:    AD, Tensor, Tape, Serialize, Transformer
  build-depends:    base >=4.17 && <5
                  , hmatrix
                  , random
                  , vector
                  , deepseq
  ghc-options:      -O2 -threaded -rtsopts
  default-language: Haskell2010

-- Full transformer training toward grokking (1- or 2-layer; modes p5/p53/p53hi/p97/p97hi
-- and p5l2/p53l2/p97l2, default p97l2 — the paper's modulus, 2 layers).
executable backend-transformer-train
  main-is:          Main.hs
  hs-source-dirs:   backend/transformer
  other-modules:    AD, Tensor, Tape, Serialize, Transformer, Optimizer
  build-depends:    base >=4.17 && <5
                  , hmatrix
                  , random
                  , directory
                  , vector
                  , deepseq
                  , time
                  , optparse-applicative
                  , parallel
  ghc-options:      -O2 -threaded -rtsopts "-with-rtsopts=-N -A64m -I0"
  default-language: Haskell2010
