cabal-version:      3.0
name:               modartransformer-backend
version:            0.1.0.0
synopsis:           Backend experiments for the modular arithmetic transformer
license:            MIT
build-type:         Simple

executable cont-ad-playground
  main-is:          ContADPlayground.hs
  hs-source-dirs:   backend
  other-modules:    AD
                  , Cat
                  , Tensor
  build-depends:    base >=4.17 && <5
  ghc-options:      -O2 -Wall -threaded -rtsopts
  default-language: Haskell2010
  default-extensions:
    DataKinds
    KindSignatures
    RankNTypes
    ScopedTypeVariables
    TypeApplications

executable backend-train-epoch
  main-is:          BackendTrainEpoch.hs
  hs-source-dirs:   backend
  other-modules:    Cat
                  , AD
                  , Tensor
  build-depends:    base >=4.17 && <5
  ghc-options:      -O2 -Wall -threaded -rtsopts
  default-language: Haskell2010
  default-extensions:
    DataKinds
    KindSignatures
    RankNTypes
    ScopedTypeVariables
    TypeApplications
