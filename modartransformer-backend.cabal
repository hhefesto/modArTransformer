cabal-version:      3.0
name:               modartransformer-backend
version:            0.1.0.0
synopsis:           Backend experiments for the modular arithmetic transformer
license:            MIT
build-type:         Simple

-- Finite-difference gradient check: guarantees the Wengert-tape reverse-mode
-- adjoints match numerical differences (CI gate, run by checks.transformer-gradcheck).
executable transformer-gradcheck
  main-is:          GradCheck.hs
  hs-source-dirs:   backend/transformer
  other-modules:    AD, Tensor, Tape, Serialize, Transformer
  build-depends:    base >=4.17 && <5
                  , hmatrix
                  , random
                  , vector
                  , deepseq
  ghc-options:      -O2 -threaded -rtsopts
  default-language: Haskell2010

-- Haskell side of the Agda<->backend conformance oracle.
executable transformer-conformance
  main-is:          Conformance.hs
  hs-source-dirs:   backend/transformer
  other-modules:    AD, Tensor, Tape, Serialize, Transformer
  build-depends:    base >=4.17 && <5
                  , hmatrix
                  , random
                  , vector
                  , deepseq
  ghc-options:      -O2 -threaded -rtsopts
  default-language: Haskell2010

-- Full transformer training toward grokking (1- or 2-layer; modes p5/p53/p53hi/p97/p97hi
-- and p5l2/p53l2/p97l2, default p97l2 — the paper's modulus, 2 layers).
executable backend-transformer-train
  main-is:          Main.hs
  hs-source-dirs:   backend/transformer
  other-modules:    AD, Tensor, Tape, Serialize, Transformer, Optimizer, Checkpoint
  build-depends:    base >=4.17 && <5
                  , hmatrix
                  , random
                  , directory
                  , vector
                  , deepseq
                  , time
                  , optparse-applicative
                  , bytestring
                  , binary
                  , parallel
  ghc-options:      -O2 -threaded -rtsopts "-with-rtsopts=-N -A64m -I0"
  default-language: Haskell2010

-- Harder algorithmic benchmark harness for comparing transformer topologies.
-- Starts with fixed-length Dyck-1 balanced-parentheses classification.
executable transformer-benchmarks
  main-is:          DyckBenchmark.hs
  hs-source-dirs:   backend/transformer
  other-modules:    AD, Tensor, Tape, Serialize, Transformer, Optimizer, Checkpoint
  build-depends:    base >=4.17 && <5
                  , hmatrix
                  , random
                  , vector
                  , deepseq
                  , directory
                  , optparse-applicative
                  , bytestring
                  , binary
  ghc-options:      -O2 -threaded -rtsopts
  default-language: Haskell2010

-- Enriched-semantics probe: does the trained (a+b) mod p model realize Tai-Danae
-- Bradley's enriched-category structure (Yoneda synonymy collapse + the ℤ/p
-- "grokking circle" in the space of meanings)?  Read-only over a checkpoint.
executable enriched-probe
  main-is:          EnrichedProbe.hs
  hs-source-dirs:   backend/transformer
  other-modules:    AD, Tensor, Tape, Serialize, Transformer
  build-depends:    base >=4.17 && <5
                  , hmatrix
                  , vector
                  , deepseq
                  , optparse-applicative
  ghc-options:      -O2 -threaded -rtsopts
  default-language: Haskell2010

-- Train the VERIFIED sequence transformer (ParamsSeq, conformance-gated) as a
-- next-token LM over quantized candle returns from chain-backfill CSVs.
-- Walk-forward splits, train-window-only tokenizer artifact, binary
-- checkpoints (+ best-by-val), interactive --prompt over the vocabulary.
executable market-train
  main-is:          Main.hs
  hs-source-dirs:   backend/market, backend/transformer, backend/data
  other-modules:    AD, Tensor, Tape, Serialize, Transformer, Optimizer,
                    Checkpoint, MarketTokenizer
  build-depends:    base >=4.17 && <5
                  , hmatrix
                  , random
                  , directory
                  , containers
                  , vector
                  , deepseq
                  , time
                  , optparse-applicative
                  , parallel
                  , bytestring
                  , binary
  ghc-options:      -O2 -threaded -rtsopts "-with-rtsopts=-N -A64m -I0"
  default-language: Haskell2010

-- Phase-5 Bradley probes over a trained market checkpoint (read-only):
-- magnitude/Tsallis entropy landscape, Yoneda synonymy on copresheaves,
-- numeric verification of the composition-law equality.
executable market-seq-probe
  main-is:          SeqProbe.hs
  hs-source-dirs:   backend/market, backend/transformer, backend/data
  other-modules:    AD, Tensor, Tape, Serialize, Transformer, Optimizer,
                    Checkpoint, MarketTokenizer
  build-depends:    base >=4.17 && <5
                  , hmatrix
                  , random
                  , directory
                  , vector
                  , deepseq
                  , optparse-applicative
                  , bytestring
                  , binary
  ghc-options:      -O2 -threaded -rtsopts
  default-language: Haskell2010

-- Property checks for the market tokenizer (backend/data/MarketTokenizer.hs)
-- against its Agda denotation (Semantics/MarketLanguage.agda): monotonicity,
-- vocabulary layout, decode coherence, the no-lookahead rule, artifact I/O.
executable market-tokenizer-check
  main-is:          TokenizerCheck.hs
  hs-source-dirs:   backend/data
  other-modules:    MarketTokenizer
  build-depends:    base >=4.17 && <5
                  , random
  ghc-options:      -O2
  default-language: Haskell2010

-- Phase B: a synthetic next-token "ℤ/m rotation walk" language whose enriched
-- structure is ground-truth; trains a small transformer then probes Yoneda
-- synonymy collapse + the group-action composition law.
executable synth-lang-probe
  main-is:          SynthLangProbe.hs
  hs-source-dirs:   backend/transformer
  other-modules:    AD, Tensor, Tape, Serialize, Transformer, Optimizer, Checkpoint
  build-depends:    base >=4.17 && <5
                  , hmatrix
                  , random
                  , vector
                  , deepseq
                  , directory
                  , optparse-applicative
                  , bytestring
                  , binary
  ghc-options:      -O2 -threaded -rtsopts
  default-language: Haskell2010
